EXTEND_TOP ~CORNEIL~ 0 #6
  IF ~Global("IADruidPlot","GLOBAL",6) PartyHasItem("S!misc70") Global("IADruidTalk","LOCALS",0)~ THEN
    DO ~SetGlobal("IADruidTalk","LOCALS",1)~
    REPLY @5440 GOTO 150
END

APPEND ~CORNEIL~
  IF ~~ THEN BEGIN 150
    SAY @5441
    IF ~~ THEN REPLY @5442 GOTO 160
  END

  IF ~~ THEN BEGIN 160
    SAY @5443
    IF ~~ THEN DO ~TakePartyItem("S!misc70")~ REPLY @5444 GOTO 170
  END

  IF ~~ THEN BEGIN 170
    SAY @5445
    IF ~~ THEN REPLY @5446 GOTO 180
  END

  IF ~~ THEN BEGIN 180
    SAY @5447
    IF ~~ THEN GOTO 190
  END

  IF ~~ THEN BEGIN 190
    SAY @5448
    IF ~~ THEN GOTO 200
  END

  IF ~~ THEN BEGIN 200
    SAY @5449
    IF ~~ THEN REPLY @5450 GOTO 210
  END

  IF ~~ THEN BEGIN 210
    SAY @5451
    IF ~~ THEN REPLY @5452 GOTO 220
  END

  IF ~~ THEN BEGIN 220
    SAY @5453
    IF ~~ THEN DO ~GiveItem("S!misc70",Player1)~
    UNSOLVED_JOURNAL @5517
    EXIT
  END
END
